# =====================================================
#  BOUTIDIDACT — Interface Tactile (Frontend)
#  Copier ce fichier en .env et renseigner les valeurs.
# =====================================================

# URL du serveur Backend (print-server)
# IMPORTANT : Pour une tablette, remplacez 'localhost' par l'IP du PC (ex: 192.168.1.47)
VITE_API_URL=http://localhost:3001

# Code PIN pour accéder au panneau d'administration (appui long sur le logo)
VITE_ADMIN_PIN=1234

# Délai d'inactivité avant retour automatique à l'accueil (en millisecondes)
# 60000 = 1 minute
VITE_IDLE_TIMEOUT_MS=60000
